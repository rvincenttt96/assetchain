# Server-only values. Never commit the real .env file.

NODE_ENV=development
PORT=3000
DATABASE_URL="file:./dev.db"

# Generate a long random value. Minimum 32 characters.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# Keep disabled unless explicitly running a demo environment.
DEMO_MODE=false

# Rial per USDT. Keep 0 until a trusted exchange-rate source is configured.
# When 0, trading remains disabled by the backend.
IRR_PER_USDT=0

# Frontend synthetic price simulation must stay disabled.
VITE_DEMO_PRICE_SIMULATION=false

# Direct TSETMC access may be blocked on foreign VPS servers.
TSETMC_SYNC_ENABLED=false
